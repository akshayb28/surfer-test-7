# Database
DATABASE_URL="postgresql://user:password@host:5432/surfer"
# Auth.js
AUTH_SECRET="run: openssl rand -base64 32"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Razorpay (use TEST keys in dev — card 4111 1111 1111 1111 works in test checkout)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_PUBLIC="surfer-public"
R2_BUCKET_PRIVATE="surfer-kyc"
R2_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
# Email
RESEND_API_KEY=""
EMAIL_FROM="Surfer Test <noreply@yourdomain.com>"
# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
COMMISSION_PERCENT="15"
